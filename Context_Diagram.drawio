<mxfile host="app.diagrams.net" modified="2026-09-08T04:15:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="ContextDiagram" name="1. Context Diagram">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Center System -->
        <mxCell id="sys_box" value="&lt;b&gt;SÀN ĐIỀU PHỐI XE TẢI GHÉP HÀNG&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Smart Freight Sharing Platform)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• Matching Engine (Tải trọng, CBM, Tuyến)&lt;br/&gt;• e-PoD Verification (GPS, Ảnh, Chữ ký)&lt;br/&gt;• 24h Escrow Payment Custody" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="270" width="350" height="200" as="geometry" />
        </mxCell>

        <!-- Driver Actor -->
        <mxCell id="act_driver" value="&lt;b&gt;👨‍✈️ TÀI XẾ / CHỦ XE&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Driver / Carrier)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Shipper Actor -->
        <mxCell id="act_shipper" value="&lt;b&gt;👤 CHỦ HÀNG LẺ&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Shipper / Cargo Owner)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Consignee Actor -->
        <mxCell id="act_consignee" value="&lt;b&gt;📦 NGƯỜI NHẬN HÀNG&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Consignee / Recipient)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="100" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Admin Actor -->
        <mxCell id="act_admin" value="&lt;b&gt;🛡️ QUẢN TRỊ VIÊN&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Admin / CS Specialist)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="570" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Payment Gateway External System -->
        <mxCell id="ext_payment" value="&lt;b&gt;💳 CỔNG THANH TOÁN&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(VietQR / VNPAY / Banking)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="495" y="40" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Map & GPS External System -->
        <mxCell id="ext_map" value="&lt;b&gt;🗺️ MAP &amp; GPS TELEMATICS&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Google Maps / Vietmap API)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="495" y="640" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Connectors: Driver <-> System -->
        <mxCell id="edge_drv_sys" value="1. Đăng chuyến về (Lộ trình, W, V)&#xa;2. Chấp nhận ghép đơn&#xa;3. Gửi e-PoD (Ảnh, GPS, Chữ ký)&#xa;4. Yêu cầu rút tiền ví" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="act_driver" target="sys_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_sys_drv" value="• Thông báo đơn ghép tiện đường&#xa;• Cảnh báo giọng nói (Drive Mode)&#xa;• Tiền cước giải ngân vào Ví (90%)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#82b366;fontSize=11;dashed=1;" edge="1" parent="1" source="sys_box" target="act_driver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Connectors: Shipper <-> System -->
        <mxCell id="edge_shp_sys" value="1. Tạo đơn (kg, CBM, Loại đường)&#xa;2. Chọn xe &amp; Nạp tiền Escrow&#xa;3. Xác nhận sớm / Khiếu nại (24h)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="act_shipper" target="sys_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_sys_shp" value="• Danh sách xe gợi ý phù hợp&#xa;• GPS theo dõi xe thời gian thực&#xa;• Biên bản e-PoD đã ký" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d79b00;fontSize=11;dashed=1;" edge="1" parent="1" source="sys_box" target="act_shipper">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Connectors: Consignee <-> System -->
        <mxCell id="edge_csg_sys" value="Ký chữ ký cảm ứng / Cung cấp OTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d6b656;fontSize=11;" edge="1" parent="1" source="act_consignee" target="sys_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_sys_csg" value="Gửi tin nhắn SMS OTP xác thực" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d6b656;fontSize=11;dashed=1;" edge="1" parent="1" source="sys_box" target="act_consignee">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Connectors: Admin <-> System -->
        <mxCell id="edge_adm_sys" value="1. Duyệt KYC tài xế &amp; Xe tải&#xa;2. Phán quyết khiếu nại (Dispute)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#b85450;fontSize=11;" edge="1" parent="1" source="act_admin" target="sys_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Connectors: External Systems -->
        <mxCell id="edge_pay" value="Xác thực thanh toán &amp; Webhook Escrow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="ext_payment" target="sys_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge_map" value="Định tuyến Polyline &amp; Cảnh báo cấm tải" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="ext_map" target="sys_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
