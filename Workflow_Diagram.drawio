  <diagram id="WorkflowDiagram" name="2. End-to-End Workflow">
    <mxGraphModel dx="1086" dy="784" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1400" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;startSize=30;rounded=1;strokeWidth=2;" value="&lt;b&gt;GIAI ĐOẠN 1: KHỞI TẠO CUNG &amp; CẦU (SUPPLY &amp; DEMAND INITIALIZATION)&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="1000" x="80" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p1_a1" parent="p1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;strokeWidth=1.5;" value="&lt;b&gt;👨‍✈️ Tài xế kích hoạt chuyến về&lt;/b&gt;&lt;br/&gt;• Khai báo điểm đi, điểm đến, ETD&lt;br/&gt;• Khai báo tải trọng trống (kg, CBM)&lt;br/&gt;• Chọn tuyến (Cao tốc / Quốc lộ)" vertex="1">
          <mxGeometry height="80" width="260" x="50" y="45" as="geometry" />
        </mxCell>
        <mxCell id="p1_a2" parent="p1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;strokeWidth=1.5;" value="&lt;b&gt;&amp;nbsp;Chủ hàng tạo đơn gửi hàng&lt;/b&gt;&lt;br&gt;• Điểm lấy, điểm giao, giờ cần gửi&lt;br&gt;• Nhập khối lượng (kg) &amp;amp; Kích thước (DxRxC)&lt;br&gt;• Chọn điều kiện đường vào (FN-02.1B)" vertex="1">
          <mxGeometry height="80" width="270" x="680" y="45" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;startSize=30;rounded=1;strokeWidth=2;" value="&lt;b&gt;GIAI ĐOẠN 2: MATCHING &amp; ĐẶT CỌC ESCROW (MATCHING &amp; PRE-AUTHORIZATION)&lt;/b&gt;" vertex="1">
          <mxGeometry height="230" width="1000" x="80" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p2_scan" parent="p2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;strokeWidth=1.5;" value="&lt;b&gt;💻 THUẬT TOÁN QUÉT MATCHING&lt;/b&gt;&lt;br/&gt;1. Tải trọng: W_đơn &amp;le; W_trống&lt;br/&gt;2. Thể tích: V_đơn &amp;le; V_trống&lt;br/&gt;3. Hành lang tuyến: Lệch &amp;le; 10km&lt;br/&gt;4. Loại đường: Khớp kích thước xe" vertex="1">
          <mxGeometry height="85" width="280" x="360" y="45" as="geometry" />
        </mxCell>
        <mxCell id="p2_dec" parent="p2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" value="Có xe phù hợp?" vertex="1">
          <mxGeometry height="60" width="130" x="435" y="155" as="geometry" />
        </mxCell>
        <mxCell id="p2_list" parent="p2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="&lt;b&gt;Gợi ý danh sách xe tải chuyến về&lt;/b&gt;&lt;br/&gt;Chủ hàng chọn xe &amp;amp; Gửi yêu cầu" vertex="1">
