        <mxCell id="p2_wait" parent="p2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="&lt;b&gt;Đăng đơn lên sàn chờ (Pending)&lt;/b&gt;&lt;br/&gt;Chờ tài xế tiện đường nhận" vertex="1">
