        <mxCell id="p5_happy" parent="p5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;strokeWidth=1.5;" value="&lt;b&gt;✅ TỰ ĐỘNG GIẢI NGÂN (HAPPY PATH)&lt;/b&gt;&lt;br/&gt;• Trừ 10% phí hoa hồng sàn&lt;br/&gt;• Cộng 90% tiền cước vào Ví Tài xế&lt;br/&gt;&lt;i&gt;Status: COMPLETED&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="250" x="100" y="170" as="geometry" />
