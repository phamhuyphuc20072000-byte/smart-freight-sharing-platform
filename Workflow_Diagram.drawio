        <mxCell id="p3_escrow" parent="p3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;strokeWidth=1.5;" value="&lt;b&gt;💳 Khóa tiền Escrow Vault&lt;/b&gt;&lt;br/&gt;Chủ hàng thanh toán cước 100% qua QR/Ngân hàng&lt;br/&gt;&lt;i&gt;Status: MATCHED&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="260" x="100" y="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_pickup" parent="p3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;strokeWidth=1.5;" value="&lt;b&gt;📦 Bốc hàng &amp; Chụp ảnh đối chứng đầu vào&lt;/b&gt;&lt;br/&gt;Tài xế đến kho lấy hàng, chụp ảnh tem mác&lt;br/&gt;&lt;i&gt;Status: IN_TRANSIT (Live GPS Tracking)&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="310" x="580" y="55" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;startSize=30;rounded=1;strokeWidth=2;" value="&lt;b&gt;GIAI ĐOẠN 4: GIAO NHẬN ĐIỆN TỬ e-PoD (ELECTRONIC PROOF OF DELIVERY)&lt;/b&gt;" vertex="1">
          <mxGeometry height="180" width="1000" x="80" y="690" as="geometry" />
        </mxCell>
        <mxCell id="p4_epod" parent="p4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;strokeWidth=2;" value="&lt;b&gt;📱 THỰC HIỆN e-PoD TẠI ĐIỂM GIAO&lt;/b&gt;&lt;br/&gt;1. Check GPS Geofence &amp;le; 200m (Anti-Mock GPS)&lt;br/&gt;2. Chụp &amp;ge; 2 ảnh hiện trạng hàng hóa trực tiếp&lt;br/&gt;3. Người nhận ký tên cảm ứng (hoặc mã SMS OTP)&lt;br/&gt;&lt;i&gt;Status đổi sang: DELIVERED&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="380" x="310" y="45" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;startSize=30;rounded=1;strokeWidth=2;" value="&lt;b&gt;GIAI ĐOẠN 5: ĐẾM NGƯỢC 24H &amp; GIẢI NGÂN (24-HOUR SETTLEMENT &amp; DISPUTE)&lt;/b&gt;" vertex="1">
          <mxGeometry height="260" width="1000" x="80" y="900" as="geometry" />
        </mxCell>
        <mxCell id="p5_timer" parent="p5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;⏱️ Kích hoạt bộ đếm ngược 24h&lt;/b&gt;&lt;br/&gt;Hiện đồng hồ 23:59:59 trên cả 2 App" vertex="1">
