        <mxCell id="p5_check" parent="p5" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" value="Trong 24h có Khiếu nại?" vertex="1">
          <mxGeometry height="60" width="170" x="415" y="125" as="geometry" />
